---
import '../styles/global.css';
import NavBar from '../components/layout/NavBar.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Agrega <meta name="robots" content="noindex, ..."> */
  noindex?: boolean;
  /** Con noindex: usa "nofollow" en vez de "follow" */
  nofollow?: boolean;
}
const { title = 'webs4all', description, noindex = false, nofollow = false } = Astro.props;

// URL canónica con barra final (coincide con la salida estática /ruta/index.html)
let canonicalPath = Astro.url.pathname;
if (!canonicalPath.endsWith('/') && !/\.\w+$/.test(canonicalPath)) canonicalPath += '/';
const canonical = Astro.site ? new URL(canonicalPath, Astro.site).href : undefined;

// En la home las anclas son locales (#servicios); en otras páginas, /#servicios
const hrefPrefix = Astro.url.pathname === '/' ? '' : '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content={`noindex, ${nofollow ? 'nofollow' : 'follow'}`} />}
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-(--space-16) focus:top-(--space-16) focus:z-200 focus:rounded-md focus:bg-surface-white focus:px-(--space-16) focus:py-(--space-12) focus:font-semibold focus:text-ink"
    >
      Saltar al contenido
    </a>
    <NavBar site={site} hrefPrefix={hrefPrefix} />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter site={site} />
  </body>
</html>
