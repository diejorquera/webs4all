---
import Button from '../ui/Button.astro';
import { buildWhatsappUrl } from '../../lib/whatsapp';

// Textos copiados del artboard "Precios · resumen (inicio)", sin cambios.

const plans = [
  {
    name: 'One Page',
    cta: 'Elegir plan',
    message: 'Hola Diego, quiero comprar el plan One Page en oferta ($100.000). Mi negocio es…',
    desc: 'Una sola página con todo lo esencial para presentar tu negocio en internet.',
    oldPrice: '$125.000',
    price: '$100.000',
    discount: '20% dto.',
    items: [
      'Diseño one page responsive',
      'Dominio + hosting 1 año',
      'WhatsApp, formulario de contacto',
      'Certificado SSL incluido',
      'Entrega en 5–7 días hábiles',
    ],
    ideal:
      'negocios nuevos, emprendimientos, profesionales independientes o cualquier negocio que hoy no tiene presencia web.',
    excludes: [
      'Diseño de logo (si no tienes, puedo cotizarlo aparte)',
      'Más de una página',
      'Blog',
      'Tienda online',
    ],
  },
  {
    name: 'Tienda virtual',
    cta: 'Elegir plan',
    message: 'Hola Diego, quiero comprar una tienda virtual con carrito de compra ($179.000). Mi negocio es…',
    desc: 'Vende online con carrito de compra y recibe pagos con Webpay o Mercado Pago.',
    popular: true,
    oldPrice: '$199.000',
    price: '$179.000',
    discount: '10% dto.',
    items: [
      'Tienda Shopify o WooCommerce configurada',
      'Hasta 20 productos cargados',
      'Pasarela de pago (Webpay, Mercado Pago)',
      'Dominio .cl + hosting 1 año',
      'Entrega en 10–14 días hábiles',
    ],
    ideal:
      'negocios con productos físicos o digitales que quieren vender online con una plataforma robusta y confiable.',
    excludes: [
      'Fotografía de productos',
      'Plan Shopify mensual, si eliges Shopify (desde US$29/mes por tu cuenta)',
      'Más de 20 productos en la carga inicial',
    ],
  },
  {
    name: 'Web Profesional',
    cta: 'Elegir plan',
    message: 'Hola Diego, quiero comprar el plan Web Profesional ($169.000). Mi negocio es…',
    desc: 'Hasta 5 páginas para mostrar tu empresa o tus servicios con una presencia completa.',
    price: '$169.000',
    items: [
      'Hasta 5 páginas o secciones',
      'Dominio .cl + hosting 1 año',
      'SEO básico + Google Analytics 4',
      'Google Maps integrado',
      'WhatsApp, formulario, correo',
      'Entrega en 7–10 días hábiles',
    ],
    ideal:
      'empresas, consultorios, servicios, restaurantes o cualquier negocio que quiere una presencia completa con múltiples secciones o páginas.',
    excludes: [
      'Logo',
      'Creación de contenido (textos e imágenes los provee el cliente)',
      'Tienda online',
      'Blog con más de 5 artículos iniciales',
    ],
  },
  {
    name: 'Web + Branding',
    cta: 'Elegir plan',
    message: 'Hola Diego, quiero comprar el plan Web + Branding ($229.000). Mi negocio es…',
    desc: 'Tu sitio web junto con logo y manual de colores para construir tu identidad.',
    price: '$229.000',
    items: [
      'Web profesional (5 páginas) con blog',
      'Diseño de logotipo',
      'Manual de colores',
      '2 banners para redes sociales',
      'Dominio .cl + hosting 1 año',
      'Entrega en 12–15 días hábiles',
    ],
    ideal:
      'negocios nuevos que necesitan construir su identidad desde cero, o marcas que quieren renovarse con web + imagen coordinada.',
    excludes: [] as string[],
  },
];
---

<section id="precios" class="ps" aria-labelledby="t-precios-inicio">
  <!-- Grano (multiply, como en el artboard) -->
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    class="pointer-events-none absolute inset-0 z-0 h-full w-full opacity-40 mix-blend-multiply"
  >
    <filter id="grain-precios-resumen" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"
      ></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-precios-resumen)"></rect>
  </svg>

  <div class="ps-wrap">
    <div class="ps-head">
      <h2 class="ps-h2" id="t-precios-inicio">
        Precios claros para el sitio web que necesita tu proyecto
      </h2>
      <p class="ps-intro">
        Revisa lo que realmente necesitas y elige el plan que mejor calce con tu negocio. Si tienes
        dudas, pregúntame y te ayudo a decidir.
      </p>
    </div>

    <!-- Carrusel arrastrable en pantallas medias y chicas; grilla de 4 en escritorio -->
    <div class="ps-scroller" tabindex="0" role="region" aria-label="Planes (desliza para ver más)">
      <ul class="ps-grid">
        {
          plans.map((p, i) => (
            <li class:list={['ps-card', { 'is-pop': p.popular }]} data-open="false">
              <div class="ps-badgerow">{p.discount && <span class="ps-disc">{p.discount}</span>}</div>
              <h3 class="ps-name">{p.name}</h3>
              <p class="ps-desc">{p.desc}</p>

              <div class="ps-pricebox">
                {p.oldPrice ? (
                  <p class="ps-old">
                    <span class="sr-only">Precio normal </span>
                    <del>{p.oldPrice}</del>
                  </p>
                ) : (
                  <p class="ps-old" aria-hidden="true">
                    &nbsp;
                  </p>
                )}
                <p class="ps-price">
                  <span class="sr-only">Precio actual </span>
                  <strong class="ps-now">{p.price}</strong>
                </p>
              </div>

              <Button
                href={buildWhatsappUrl(p.message)}
                variant="secondary"
                arrow
                class="ps-cta"
                target="_blank"
                rel="noopener noreferrer"
              >
                {p.cta}
              </Button>

              <ul class="ps-list">
                {p.items.map((item) => (
                  <li>
                    <span class="ps-ic" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 9.5l3.5 3.5 7.5-8" /></svg>
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <button type="button" class="ps-toggle" aria-expanded="false" aria-controls={`ps-more-${i + 1}`}>
                <span>
                  <span class="ps-lbl-more">Ver más información</span>
                  <span class="ps-lbl-less">Ver menos</span>
                </span>
                <span aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                    <path d="M2 8h12" />
                    <path class="ps-v" d="M8 2v12" />
                  </svg>
                </span>
              </button>

              <div class="ps-panel" id={`ps-more-${i + 1}`}>
                <div class="ps-clip">
                  <div class="ps-more">
                    <p class="ps-ideal">
                      <strong>Ideal para:</strong> {p.ideal}
                    </p>
                    {p.excludes.length > 0 && (
                      <div>
                        <h4 class="ps-lh">No incluye</h4>
                        <ul class="ps-list ps-list-no">
                          {p.excludes.map((item) => (
                            <li>
                              <span class="ps-ic" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4.5 9h9" /></svg>
                              </span>
                              <span>{item}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</section>

<script>
  // Despliegue de "Ver más información" (sin React)
  document.querySelectorAll<HTMLButtonElement>('.ps-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest<HTMLElement>('.ps-card');
      if (!card) return;
      const open = card.dataset.open !== 'true';
      card.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>

<style>
  .ps {
    position: relative;
    container-type: inline-size;
    background: var(--color-surface-lilac);
    color: var(--color-text-primary);
  }
  .ps :global(a:focus-visible),
  .ps :global(button:focus-visible) {
    outline: var(--border-width-strong) solid var(--color-ink);
    outline-offset: var(--focus-offset);
    border-radius: var(--radius-md);
  }
  .ps-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4cqw, 56px);
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: clamp(40px, 5cqw, 80px) var(--space-gutter-x) clamp(64px, 8cqw, 120px);
  }

  /* ───── Encabezado ───── */
  .ps-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-20) var(--space-64);
  }
  .ps-h2 {
    margin: 0;
    font-size: var(--text-h3-section);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }
  .ps-intro {
    flex: 0 1 520px;
    margin: 0;
    font-size: var(--text-lead);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  /* ───── Tarjetas ───── */
  .ps-scroller {
    overflow-x: visible;
  }
  .ps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    gap: clamp(16px, 2cqw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ps-card {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    /* 18px: medida del artboard sin token equivalente */
    gap: 18px;
    padding: var(--space-24);
    background: var(--color-surface-white);
    border: var(--border-width) solid var(--color-border-lilac);
    border-radius: var(--radius-xl);
  }
  .ps-card.is-pop {
    background: var(--gradient-violet);
    border-color: transparent;
    color: var(--color-text-on-dark);
  }
  .ps-card.is-pop .ps-desc,
  .ps-card.is-pop .ps-ideal,
  .ps-card.is-pop .ps-old {
    color: var(--color-text-on-dark-muted);
  }
  .ps-card.is-pop .ps-ideal strong,
  .ps-card.is-pop .ps-ic {
    color: var(--color-text-on-dark);
  }
  .ps-card.is-pop .ps-list li {
    border-top-color: var(--color-border-on-dark);
    color: var(--color-text-on-dark);
  }
  .ps-card.is-pop .ps-list-no li,
  .ps-card.is-pop .ps-list-no .ps-ic {
    color: var(--color-text-on-dark-muted);
  }
  .ps-card.is-pop .ps-toggle {
    border-color: var(--color-text-on-dark);
    color: var(--color-text-on-dark);
  }
  .ps-card.is-pop .ps-toggle:hover {
    background: var(--color-text-on-dark);
    color: var(--color-violet-900);
  }
  .ps-card.is-pop :global(a:focus-visible),
  .ps-card.is-pop :global(button:focus-visible) {
    outline-color: var(--color-text-on-dark);
  }
  .ps-name {
    margin: 0;
    font-size: var(--text-body-lg);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--leading-none);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .ps-pricebox {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-8);
  }
  .ps-card :global(.ps-cta) {
    width: 100%;
    color: var(--color-violet-700);
    --btn-hover-bg: var(--color-violet-700);
    --btn-hover-fg: var(--color-text-on-dark);
  }
  .ps-card :global(.ps-cta:hover) {
    color: var(--btn-hover-fg);
  }
  .ps-card.is-pop :global(.ps-cta) {
    color: var(--color-text-on-dark);
    --btn-hover-bg: var(--color-text-on-dark);
    --btn-hover-fg: var(--color-violet-900);
  }
  .ps-card.is-pop :global(.ps-cta:hover) {
    color: var(--btn-hover-fg);
  }
  .ps-old {
    margin: 0;
    font-size: 20px; /* sin token */
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-none);
    color: var(--color-text-tertiary);
  }
  .ps-old del {
    text-decoration-thickness: var(--border-width-strong);
  }
  .ps-price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-10) var(--space-14);
    margin: 0;
  }
  .ps-now {
    font-size: var(--text-price-sm);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-heading);
  }
  .ps-badgerow {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    /* reserva la altura para que los nombres queden alineados aunque no haya descuento */
    min-height: 22px;
  }
  .ps-disc {
    display: inline-flex;
    align-items: center;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-tag);
    background: var(--color-violet-700);
    color: var(--color-text-on-dark);
    font-size: var(--text-label-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-label-xs);
    line-height: var(--leading-none);
    white-space: nowrap;
  }
  .ps-card.is-pop .ps-disc {
    background: var(--color-lilac-200);
    color: var(--color-violet-900);
  }
  .ps-desc {
    margin: 0;
    min-height: calc(var(--leading-normal) * 3em);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-tertiary);
  }

  /* ───── Listas ───── */
  .ps-list {
    margin: 0 0 auto;
    padding: 0;
    list-style: none;
  }
  .ps-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-12);
    padding: var(--space-10) 0;
    border-top: var(--border-width) solid var(--color-border-lilac);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
  }
  .ps-ic {
    display: flex;
    flex: 0 0 auto;
    margin-top: 1px;
    color: var(--color-ink);
  }
  .ps-list-no {
    margin: 0;
  }
  .ps-list-no li {
    color: var(--color-text-tertiary);
  }
  .ps-list-no .ps-ic {
    color: var(--color-text-tertiary);
  }
  .ps-lh {
    margin: 0 0 var(--space-4);
    font-size: var(--text-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .ps-ideal {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }
  .ps-ideal strong {
    color: var(--color-ink);
  }

  /* ───── Desplegable ───── */
  .ps-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    width: 100%;
    min-height: 48px;
    padding: 0 var(--space-14);
    border: var(--border-width) solid var(--color-ink);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-ink);
    font-family: inherit;
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-semibold);
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-200),
      color var(--duration-200);
  }
  .ps-toggle:hover {
    background: var(--color-ink);
    color: var(--color-text-on-dark);
  }
  .ps-lbl-less {
    display: none;
  }
  .ps-card[data-open='true'] .ps-lbl-more {
    display: none;
  }
  .ps-card[data-open='true'] .ps-lbl-less {
    display: inline;
  }
  .ps-v {
    transform-origin: 8px 8px;
    transition:
      opacity var(--duration-200),
      transform var(--duration-200);
  }
  .ps-card[data-open='true'] .ps-v {
    opacity: 0;
    transform: rotate(90deg);
  }
  .ps-panel {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: -18px; /* anula el gap de la tarjeta mientras está cerrado */
    transition: grid-template-rows var(--duration-400) var(--ease-out);
  }
  .ps-card[data-open='true'] .ps-panel {
    grid-template-rows: 1fr;
    margin-top: 0;
  }
  .ps-clip {
    min-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s var(--duration-400);
  }
  .ps-card[data-open='true'] .ps-clip {
    visibility: visible;
    transition-delay: 0s;
  }
  .ps-more {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @container (min-width: 1100px) and (max-width: 1259px) {
    .ps-desc {
      min-height: calc(var(--leading-normal) * 4em);
    }
  }

  /* Carrusel arrastrable (scroll-snap) en pantallas medias y chicas */
  @container (max-width: 1099px) {
    .ps-scroller {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      /* deja respirar el foco y la sombra de las tarjetas */
      padding-bottom: var(--space-12);
    }
    .ps-grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(320px, 82%);
    }
    .ps-card {
      scroll-snap-align: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ps-toggle,
    .ps-v,
    .ps-panel,
    .ps-clip {
      transition: none;
    }
  }
</style>
