---
import Tag from '../ui/Tag.astro';
import Button from '../ui/Button.astro';
import FinePrint from '../ui/FinePrint.astro';
import { buildWhatsappUrl } from '../../lib/whatsapp';

// Textos del documento de contenido de precios, sin cambios.

interface Props {
  /** Home: versión resumida (encabezado, 4 tarjetas y botones) */
  compact?: boolean;
  /** /precios/: el encabezado es el h1 de la página */
  asH1?: boolean;
}
const { compact = false, asH1 = false } = Astro.props;
const Heading = asH1 ? 'h1' : 'h2';

const whatsappHref = buildWhatsappUrl();

const plans = [
  {
    name: 'One Page',
    price: '$89.000',
    oldPrice: '$100.000',
    discount: '11% dto.',
    badge: 'Oferta',
    cta: 'Comienza con una One Page',
    message: 'Hola Diego, quiero comprar el plan One Page en oferta ($89.000). Mi negocio es…',
    items: [
      'Diseño one page responsive',
      'Dominio + hosting 1 año',
      'WhatsApp, formulario de contacto',
      'Certificado SSL incluido',
      'Entrega en 5–7 días hábiles',
    ],
    ideal:
      'Ideal para: negocios nuevos, emprendimientos, profesionales independientes o cualquier negocio que hoy no tiene presencia web.',
    includes: [
      'Diseño de una página larga con secciones (inicio, servicios/productos, sobre mí, contacto)',
      'Dominio registrado a tu nombre + hosting por 1 año',
      'Botón de WhatsApp flotante',
      'Formulario de contacto que llega a tu correo',
      'Certificado SSL incluido',
      'Diseño responsive (se ve bien en celular, tablet y computador)',
      'Entrega en 5–7 días hábiles',
    ],
    excludes: [
      'Diseño de logo (si no tienes, puedo cotizarlo aparte)',
      'Más de una página',
      'Blog',
      'Tienda online',
    ],
    notes: [
      'Renovación anual (referencia): Hosting + dominio: aproximadamente $35.000–$45.000/año según proveedor.',
    ],
  },
  {
    name: 'Tienda con carrito de compra',
    price: '$199.000',
    badge: 'Más popular',
    popular: true,
    cta: 'Comienza con tu tienda',
    message: 'Hola Diego, quiero comprar una tienda con carrito de compra ($199.000). Mi negocio es…',
    items: [
      'Tienda Shopify o WooCommerce configurada',
      'Hasta 20 productos cargados',
      'Pasarela de pago (Webpay, Mercado Pago)',
      'Dominio .cl + hosting 1 año',
      'Entrega en 10–14 días hábiles',
    ],
    ideal:
      'Ideal para: negocios con productos físicos o digitales que quieren vender online con una plataforma robusta y confiable.',
    includes: [
      'Tienda Shopify o tienda WooCommerce configurada y personalizada',
      'Hasta 20 productos cargados (con fotos y descripción que tú provees)',
      'Integración con pasarela de pago (Webpay Plus o Mercado Pago)',
      'Configuración de envíos y/o retiro en tienda',
      'Dominio .cl conectado a la tienda',
      'Capacitación básica de 30 min para administrar tu tienda',
      'Entrega en 10–14 días hábiles',
    ],
    excludes: [
      'Fotografía de productos',
      'Plan Shopify mensual, si eliges Shopify (desde US$29/mes por tu cuenta)',
      'Más de 20 productos en la carga inicial',
    ],
    notes: [
      '¿Por qué Shopify? Es la plataforma de e-commerce más usada del mundo. Funciona en Chile con Webpay y Mercado Pago, tiene app para administrar desde el celular y crece contigo.',
      'Nota sobre el plan Shopify: Shopify cobra una mensualidad directamente a ti (no a mí). El plan básico parte en US$29/mes (~$27.000 CLP). Es el costo de operar la plataforma, no mío.',
    ],
  },
  {
    name: 'Web Profesional',
    price: '$169.000',
    popular: false,
    cta: 'Comienza con una Web Profesional',
    message: 'Hola Diego, quiero comprar el plan Web Profesional ($169.000). Mi negocio es…',
    items: [
      'Hasta 5 páginas o secciones',
      'Dominio .cl + hosting 1 año',
      'SEO básico + Google Analytics 4',
      'Google Maps integrado',
      'WhatsApp, formulario, correo',
      'Entrega en 7–10 días hábiles',
    ],
    ideal:
      'Ideal para: empresas, consultorios, servicios, restaurantes o cualquier negocio que quiere una presencia completa con múltiples secciones o páginas.',
    includes: [
      'Hasta 5 páginas o secciones (ej: Inicio, Servicios, Sobre mí, Blog, Contacto)',
      'Dominio .cl + hosting 1 año',
      'SEO básico on-page (títulos, meta descripciones, estructura)',
      'Integración con Google Analytics 4 (para ver visitas)',
      'Google Maps integrado',
      'Botón de WhatsApp + formulario de contacto + enlace a correo',
      'Entrega en 7–10 días hábiles',
    ],
    excludes: [
      'Logo',
      'Creación de contenido (textos e imágenes los provee el cliente)',
      'Tienda online',
      'Blog con más de 5 artículos iniciales',
    ],
    notes: [],
  },
  {
    name: 'Web + Branding',
    price: '$229.000',
    popular: false,
    cta: 'Comienza con Web + Branding',
    message: 'Hola Diego, quiero comprar el plan Web + Branding ($229.000). Mi negocio es…',
    items: [
      'Web profesional (5 páginas) con blog',
      'Diseño de logotipo',
      'Manual de colores',
      '2 banners para redes sociales',
      'Dominio .cl + hosting 1 año',
      'Entrega en 12–15 días hábiles',
    ],
    ideal:
      'Ideal para: negocios nuevos que necesitan construir su identidad desde cero, o marcas que quieren renovarse con web + imagen coordinada.',
    includes: [
      'Todo lo de Web Profesional (5 páginas)',
      'Blog incluido',
      'Diseño de logotipo (hasta 3 propuestas + 2 rondas de ajuste)',
      'Manual básico de marca (paleta de colores, tipografías)',
      '2 banners para redes sociales (formato stories + post cuadrado)',
      'Dominio .cl + hosting 1 año',
      'Entrega en 12–15 días hábiles',
    ],
    excludes: [],
    notes: [],
  },
];

const allInclude = [
  'Dominio .cl a tu nombre por 1 año (tú lo renuevas después, es tuyo)',
  'Hosting por 1 año',
  'Certificado SSL (candado verde en el navegador)',
  'Sitio mobile-first (adaptado a celular)',
  'El sitio es 100% tuyo — no dependes de mí para existir en internet',
];

const faqs = [
  [
    '¿Tienes dudas?',
    'Escríbeme por WhatsApp y te cotizo en menos de 1 hora. Todos los precios son finales y no incluyen IVA, porque trabajo con boleta de honorarios. El dominio y hosting son por 1 año; la renovación anual corre por cuenta del cliente.',
  ],
  [
    '¿El precio incluye IVA?',
    'No. Todos los precios son finales y no incluyen IVA, porque trabajo con boleta de honorarios. Emito una boleta por cada pago.',
  ],
  [
    '¿Cómo es el proceso de pago?',
    '50% al inicio del proyecto y 50% contra entrega. Acepto transferencia bancaria.',
  ],
  [
    '¿Qué necesito tener listo para empezar?',
    'Textos y fotos de tu negocio, tu logo (si tienes), y saber qué quieres mostrar. Si no tienes algunas de estas cosas, conversamos.',
  ],
  [
    '¿Cuándo empieza el plazo de entrega?',
    'Una vez recibido el pago inicial y todos los materiales necesarios.',
  ],
  [
    '¿Qué pasa con el hosting y dominio después del primer año?',
    'El primer año está incluido. Pasado ese tiempo, tú renuevas directamente con el proveedor (te guío en ese proceso). El costo anual estimado es de $35.000–$45.000 CLP.',
  ],
  [
    '¿Puedo agregar páginas o funciones después?',
    'Sí, cotizo mejoras o ampliaciones una vez entregado el proyecto.',
  ],
  ['¿Haces mantenimiento?', 'Sí, cotizo planes de mantenimiento mensual según lo que necesites.'],
  [
    '¿Qué significa que el sitio es mío?',
    'Que el dominio está registrado a tu nombre y el sitio puede existir aunque dejes de trabajar conmigo. No soy intermediario: tú eres el dueño.',
  ],
];
---

<section id="precios" class="pr relative">
  <!-- Grano (multiply, como en el artboard) -->
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    class="pointer-events-none absolute inset-0 z-20 h-full w-full opacity-[0.38] mix-blend-multiply"
  >
    <filter id="grain-precios" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"
      ></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-precios)"></rect>
  </svg>

  <div class="pr-wrap">
    <div class="pr-head">
      <Heading class="pr-h2">
        {compact ? 'Precios claros, sin sorpresas' : 'Lo que necesitas saber antes de contratar'}
      </Heading>
      <p class="pr-lead">
        {
          compact
            ? 'Todo incluye dominio .cl y hosting por 1 año. El sitio es tuyo desde el primer día.'
            : 'Publico mis precios porque creo que mereces decidir con información completa. Sin costos ocultos, sin "depende del proyecto", sin hosting que te cobran aparte.'
        }
      </p>
    </div>

    {
      compact ? (
        <>
          <div class="pr-cards pr-cards-2">
            {plans.map((p) => (
              <article class:list={['pr-card', { 'is-rec': p.popular }]}>
                <h3 class="pr-level">
                  <span>{p.name}</span>
                  {p.badge && <Tag>{p.badge}</Tag>}
                </h3>
                <p class="pr-price">
                  {p.oldPrice && (
                    <s class="pr-per w-full">
                      <span class="sr-only">Precio normal: </span>
                      {p.oldPrice}
                    </s>
                  )}
                  <span>
                    {p.oldPrice && <span class="sr-only">Precio en oferta: </span>}
                    {p.price}
                  </span>
                  {p.discount && <Tag>{p.discount}</Tag>}
                  <span class="pr-per">Boleta de honorarios</span>
                </p>
                <ul class="pr-list">
                  {p.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <Button
                  href={buildWhatsappUrl(p.message)}
                  variant="primary"
                  class="mt-auto w-full justify-center"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.cta}
                </Button>
              </article>
            ))}
          </div>

          <div class="pr-more flex-wrap gap-(--space-16)">
            <Button href="/precios/" variant="dark" arrow>
              Ver todos los detalles
            </Button>
            <Button href={whatsappHref} variant="secondary" target="_blank" rel="noopener noreferrer">
              Cotiza tu proyecto
            </Button>
          </div>
        </>
      ) : (
        <>
          <div class="pr-rule">
            <h2 class="pr-x-title">¿Qué incluyen todos los planes?</h2>
            <div>
              <p>Independiente del plan que elijas, siempre recibes:</p>
              <div class="pr-two">
                <ul class="pr-list pr-yes">
                  {allInclude.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <div class="pr-cards pr-cards-2 mt-(--space-32)">
            {plans.map((p) => (
              <article class:list={['pr-card', { 'is-rec': p.popular }]}>
                <h2 class="pr-level">
                  <span>{p.name}</span>
                  {p.badge && <Tag>{p.badge}</Tag>}
                </h2>
                <p class="pr-price">
                  {p.oldPrice && (
                    <s class="pr-per w-full">
                      <span class="sr-only">Precio normal: </span>
                      {p.oldPrice}
                    </s>
                  )}
                  <span>
                    {p.oldPrice && <span class="sr-only">Precio en oferta: </span>}
                    {p.price}
                  </span>
                  {p.discount && <Tag>{p.discount}</Tag>}
                  <span class="pr-per">Boleta de honorarios</span>
                </p>
                <p class="pr-desc">{p.ideal}</p>
                <div class="pr-two">
                  <div>
                    <h4>Incluye</h4>
                    <ul class="pr-list pr-yes">
                      {p.includes.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                  {p.excludes.length > 0 && (
                    <div>
                      <h4>No incluye</h4>
                      <ul class="pr-list pr-no">
                        {p.excludes.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
                {p.notes.map((n) => (
                  <FinePrint>{n}</FinePrint>
                ))}
                <Button
                  href={buildWhatsappUrl(p.message)}
                  variant="primary"
                  class="mt-auto w-full justify-center"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.cta}
                </Button>
              </article>
            ))}
          </div>

          <div class="pr-m" id="preguntas-precios">
            <div class="pr-mhead">
              <h2 class="pr-m-title">Preguntas frecuentes</h2>
            </div>
            {faqs.map(([q, a]) => (
              <div class="pr-rule">
                <h4>{q}</h4>
                <p>{a}</p>
              </div>
            ))}
          </div>

          <div class="pr-m">
            <div class="pr-mhead">
              <h2 class="pr-m-title">¿Listo para tener tu web?</h2>
              <p class="pr-m-lead">
                Escríbeme por WhatsApp o llena el formulario y te respondo en menos de 1 hora.
              </p>
            </div>
            <div class="flex flex-wrap gap-(--space-16)">
              <a class="pr-btn on-dark" href={whatsappHref} target="_blank" rel="noopener noreferrer">
                Escribir por WhatsApp
              </a>
              <a class="pr-btn on-dark" href="/#contacto">Llenar formulario</a>
            </div>
          </div>
        </>
      )
    }
  </div>
</section>

<style is:global>
  /* ───── Contenedor (las unidades cqw y @container dependen de esto) ───── */
  .pr {
    container-type: inline-size;
    background:
      radial-gradient(
        ellipse 70% 50% at 0% 0%,
        color-mix(in srgb, var(--color-purple-500) 12%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 60% 45% at 100% 38%,
        color-mix(in srgb, var(--color-orange-400) 14%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 70% 40% at 20% 100%,
        color-mix(in srgb, var(--color-violet-700) 10%, transparent) 0%,
        transparent 70%
      ),
      var(--color-surface-lilac);
    color: var(--color-text-primary);
  }
  .pr-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    box-sizing: border-box;
    padding: clamp(64px, 8cqw, 120px) clamp(20px, 4.5cqw, 64px);
  }
  .pr-more {
    display: flex;
    margin-top: var(--space-32);
  }
  .pr-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-20) var(--space-64);
    margin-bottom: clamp(36px, 4cqw, 56px);
  }
  .pr-h2 {
    flex: 1 1 520px;
    max-width: 860px;
    margin: 0;
    font-size: var(--text-h2-section);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }
  .pr-lead {
    flex: 1 1 320px;
    max-width: 460px;
    margin: 0;
    font-size: var(--text-lead);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  /* ───── Tarjetas de plan ───── */
  .pr-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-24);
  }
  .pr-cards.pr-cards-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .pr-card,
  .pr-mcard {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: var(--space-32);
    border-radius: var(--radius-lg);
  }
  .pr-card {
    background: var(--color-surface-white);
    border: var(--border-width) solid var(--color-border-lilac);
    transition:
      border-color var(--duration-200),
      transform var(--duration-200),
      box-shadow var(--duration-200);
  }
  .pr-card:hover {
    border-color: var(--color-text-tertiary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }
  .pr-card.is-rec {
    border: var(--border-width-strong) solid var(--color-border-strong);
    padding: calc(var(--space-32) - var(--border-width));
  }
  .pr-card.is-rec:hover {
    border-color: var(--color-border-strong);
  }

  .pr-level {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    min-height: 28px;
    margin: 0;
    font-size: var(--text-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-primary);
  }
  .pr-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4) var(--space-10);
    margin: var(--space-20) 0 0;
    font-size: var(--text-price);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-none);
    color: var(--color-text-primary);
  }
  .pr-per {
    font-size: var(--text-label);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label-xs);
    color: var(--color-text-tertiary);
  }
  .pr-desc {
    margin: var(--space-16) 0 0;
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-tertiary);
  }
  .pr-cards .pr-desc {
    min-height: 4.5em;
  }
  .pr-list {
    list-style: none;
    margin: var(--space-24) 0 var(--space-28);
    padding: 0;
    font-size: var(--text-body-sm);
    line-height: 1.4;
    color: var(--color-text-primary);
  }
  .pr-list li {
    padding: var(--space-12) 0;
    border-top: var(--border-width) solid var(--color-border-lilac-soft);
  }

  /* ───── Botones de la sección ───── */
  .pr-btn {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-10);
    min-height: 52px;
    box-sizing: border-box;
    padding: 0 var(--space-24);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-primary);
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    text-align: center;
    transition:
      background-color var(--duration-250),
      color var(--duration-250);
  }
  .pr-btn:hover {
    background: var(--color-ink);
    color: var(--color-text-on-dark);
  }
  .pr-btn.is-solid {
    background: var(--color-ink);
    color: var(--color-text-on-dark);
  }
  .pr-btn.is-solid:hover {
    background: var(--color-text-secondary);
  }
  .pr-btn.on-dark {
    border-color: var(--color-text-on-dark);
    color: var(--color-text-on-dark);
  }
  .pr-btn.on-dark:hover {
    background: var(--color-text-on-dark);
    color: var(--color-violet-900);
  }
  .pr a:focus-visible,
  .pr button:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
    border-radius: var(--radius-md);
  }
  .pr .pr-m a:focus-visible {
    outline-color: var(--color-text-on-dark);
  }

  .pr-note {
    margin-top: var(--space-32);
    max-width: 980px;
  }

  /* ───── Web Express ───── */
  .pr-x {
    margin-top: clamp(64px, 8cqw, 112px);
    box-sizing: border-box;
    background: color-mix(in srgb, var(--color-surface-white) 55%, transparent);
    border: var(--border-width) solid var(--color-border-lilac);
    border-radius: var(--radius-xl);
    padding: clamp(24px, 4cqw, 56px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3cqw, 40px);
  }
  .pr-x-title {
    margin: 0;
    font-size: clamp(24px, 2.6cqw, 36px);
    font-weight: var(--font-weight-extrabold);
    line-height: 1.05;
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }
  .pr-x-lead {
    margin: var(--space-12) 0 0;
    max-width: 640px;
    font-size: var(--text-lead);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  /* Selector de plantilla: radios nativos, la etiqueta es la miniatura */
  .pr-tpls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-20);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .pr-thumb {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .pr-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .pr-frame {
    position: relative;
    display: block;
    border: var(--border-width) solid var(--color-border-lilac);
    border-radius: var(--radius-thumb);
    background: var(--color-surface-white);
    overflow: hidden;
    transition:
      transform var(--duration-200),
      box-shadow var(--duration-200),
      border-color var(--duration-200);
  }
  .pr-thumb:hover .pr-frame {
    transform: translateY(-3px);
    box-shadow: var(--shadow-thumb-hover);
  }
  .pr-radio:checked + .pr-frame {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-ring-selected);
  }
  .pr-radio:focus-visible + .pr-frame {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }
  .pr-check {
    display: none;
    position: absolute;
    top: 36px;
    right: var(--space-10);
    width: 26px;
