---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'target' | 'rel'> {
  href: string;
}
const { href, class: className, ...attrs } = Astro.props;
---

<!-- Enlace externo: siempre en pestaña nueva, con flecha diagonal. Si no lleva texto, pasar aria-label. -->
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['ext-link', className]}
  {...attrs}
>
  <slot />
  <svg
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 18 18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="ext-link-arrow"
  >
    <path d="M4 14L14 4M6 4h8v8"></path>
  </svg>
</a>

<style>
  .ext-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    color: inherit;
    text-decoration: none;
  }
  .ext-link-arrow {
    flex-shrink: 0;
    transition: transform var(--duration-200);
  }
  .ext-link:hover .ext-link-arrow {
    transform: translate(2px, -2px);
  }
</style>
