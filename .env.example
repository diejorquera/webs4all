# Clave PÚBLICA (site key) del widget de Cloudflare Turnstile. Va en el navegador, no es secreta.
# Vacía en desarrollo: el widget no se monta y el envío se SIMULA.
PUBLIC_TURNSTILE_SITE_KEY=

# Opcional: URL alternativa para el formulario. Por defecto se usa /api/contact (Pages Function).
PUBLIC_FORM_ENDPOINT=
