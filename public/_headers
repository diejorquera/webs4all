# Cabeceras HTTP para Cloudflare (Pages / Workers con assets estáticos).
# Cloudflare lee este archivo desde la raíz del sitio publicado: no requiere configuración extra.
# Documentación: https://developers.cloudflare.com/pages/configuration/headers/
#
# El caché ya lo resuelve Cloudflare por defecto: /_astro/* (archivos con hash) sale con
# "public, max-age=31536000, immutable" y el HTML con "must-revalidate". No hace falta repetirlo.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  # Solo HTTPS durante 1 año. No activar además "HSTS" en el panel de Cloudflare para no duplicarlo.
  Strict-Transport-Security: max-age=31536000
  # CSP en modo "solo reporte": NO bloquea nada, solo escribe avisos en la consola del navegador.
  # Pasos: 1) publicar, 2) abrir el sitio con la consola (F12) y confirmar que no hay avisos,
  # 3) cambiar el nombre de la cabecera a "Content-Security-Policy" para que se aplique.
  # Si el formulario envía a un dominio concreto, reemplazar "https:" de connect-src por ese dominio.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
